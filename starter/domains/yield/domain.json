{
 "name": "yield",
 "import": {"maxKB": 500},
 "params": [
  {"key": "yield_bad", "label": "이상 판정 편차", "unit": "%p", "type": "number", "default": -2.5, "min": -10, "max": -0.5, "step": 0.1, "affects": "양산 로트 이상 판정"},
  {"key": "yield_warn", "label": "주의 판정 편차", "unit": "%p", "type": "number", "default": -1.5, "min": -10, "max": -0.5, "step": 0.1, "affects": "양산 로트 주의 판정"},
  {"key": "ab_target", "label": "이상 비율 목표", "unit": "%", "type": "number", "default": 3, "min": 0, "max": 20, "step": 0.5, "affects": "이상 비율 목표선"}
 ],
 "judge": {"col": "status", "where": {"kind": ["양산"]}, "skip": "제외", "value": {"col": "gap"}, "rules": [{"label": "이상", "op": "<=", "at": "$param:yield_bad"}, {"label": "주의", "op": "<=", "at": "$param:yield_warn"}], "else": "정상"},
 "whatIf": {"metrics": ["abnormal", "watch", "abRate"]},
 "app": {"name": "수율 이상 로트", "title": "수율 이상 로트 현황", "question": "이번 주 원인 조사를 걸 로트와 장비는 어디인가", "asOf": "2026-10-28 09:00", "today": "2026-10-28",
  "limit": "가상 데이터(실제 수율·장비와 무관) · 시험 생산 로트는 비교와 기준선에서 제외 · 기준선 = 측정일 직전 4주 같은 공정 양산 로트 평균(이전 자료 5건 미만이면 공정 공칭값) · 편차 −2.5%p 이하 이상, −1.5%p 이하 주의 · 원인은 알려주지 않고 후보만 보여 줌",
  "help": "수율 담당 · 내선 4410 · 가상 번호", "user": {"name": "수율팀", "email": "yield@fab-ops.example", "initials": "수율"}, "icon": "cpu"},
 "entity": {"singular": "로트", "plural": "로트", "unit": "건", "idLabel": "로트 ID", "searchHint": "로트 ID·장비·공정·제조사 검색", "ownerLabel": "공정"},
 "cols": [
  {"key": "lot_id", "label": "로트 ID", "type": "text", "width": 104},
  {"key": "proc", "label": "공정", "type": "text", "filter": "select", "width": 80},
  {"key": "equip", "label": "장비", "type": "text", "filter": "chip", "width": 96},
  {"key": "vendor", "label": "제조사(장비 마스터)", "type": "text", "filter": "select", "width": 120},
  {"key": "age", "label": "가동 연수(장비 마스터)", "type": "number", "width": 96},
  {"key": "kind", "label": "구분", "type": "enum", "badge": true, "filter": "select", "width": 80, "values": [{"v": "양산", "tone": "plain"}, {"v": "시험", "tone": "muted"}]},
  {"key": "yield", "label": "수율(%)", "type": "number", "width": 88},
  {"key": "base", "label": "기준선(%) 직전 4주 평균", "type": "number", "width": 120},
  {"key": "gap", "label": "편차(%p)", "type": "number", "width": 88},
  {"key": "measured", "label": "측정일", "type": "date", "width": 120},
  {"key": "status", "label": "판정", "type": "enum", "badge": true, "filter": "select", "edit": true, "width": 88, "values": [{"v": "이상", "tone": "urgent"}, {"v": "주의", "tone": "warn"}, {"v": "정상", "tone": "muted", "done": true}, {"v": "제외", "tone": "muted", "done": true}]}
 ],
 "roles": {"id": "lot_id", "title": "{equip} {lot_id}", "status": "status", "priority": null, "date": "measured", "owner": "proc", "group": "proc", "unit": "equip", "deadline": null},
 "group": {"col": "proc", "label": "공정", "suffix": "공정", "values": ["식각", "증착", "포토", "세정", "CMP"]},
 "metrics": [
  {"key": "abnormal", "label": "이상 로트", "agg": "count", "where": {"status": ["이상"]}, "unit": "건", "better": null},
  {"key": "watch", "label": "주의 로트", "agg": "count", "where": {"status": ["주의"]}, "unit": "건", "better": null},
  {"key": "abRate", "label": "이상 비율(시험 로트 포함 분모)", "agg": "rate", "where": {"status": ["이상"]}, "unit": "%", "decimals": 1, "better": "down", "target": "$param:ab_target"},
  {"key": "test", "label": "시험 로트(제외)", "agg": "count", "where": {"status": ["제외"]}, "unit": "건", "better": null},
  {"key": "count", "label": "측정 로트", "agg": "count", "unit": "건", "better": null}
 ],
 "cards": ["abnormal", "watch", "abRate", "test", "count"],
 "progress": ["abRate"],
 "due": "2026-10-30",
 "summary": ["abnormal", "watch", "test"], "summaryTargets": ["abRate"],
 "trend": {"metric": "abnormal", "title": "일별 이상 로트 건수", "allName": "전체"},
 "rank": {"col": "equip", "title": "장비별 이상·주의 로트 (쏠림)", "topN": 5, "where": {"status": ["이상", "주의"]}},
 "stack": {"title": "공정별 판정 구성", "by": "proc", "parts": "status"},
 "heat": {"title": "요일×공정 측정 로트", "cols": "proc"},
 "funnel": {"title": "조사 대상 좁히기", "steps": [{"label": "측정 로트"}, {"label": "시험 로트 제외", "where": {"!status": ["제외"]}}, {"label": "주의 이상", "where": {"status": ["이상", "주의"]}}, {"label": "이상", "where": {"status": ["이상"]}}]},
 "queue": {"title": "먼저 조사할 로트", "where": {"status": ["이상", "주의"]}, "columns": ["lot_id", "equip", "status", "gap", "measured"], "limit": 15, "topN": 5},
 "alerts": {"title": "기준선에서 크게 벗어난 로트", "where": {"status": ["이상"]}, "badge": "status", "note": "{equip} · 편차 {gap}%p", "limit": 5, "actionLabel": "이상 로트 보기"},
 "board": {"title": "판정 보드", "meta": "{proc} · 편차 {gap}%p"},
 "timeline": {"title": "이상 로트 측정 일정", "start": "measured", "end": "measured", "label": "{equip} {lot_id}", "owner": "proc", "where": {"status": ["이상"]}},
 "activity": {"title": "최근 이상 판정", "who": "proc", "what": "{_id} {equip} 편차 {gap}%p {status}", "where": {"status": ["이상", "주의"]}},
 "layout": {"title": "장비별 이상 로트", "unitCol": "equip", "cols": 5, "states": ["이상 없음", "이상 있음", "이상 다수"], "countWhere": {"status": ["이상"]}, "countLabel": "이상", "badAt": 3},
 "tabs": [{"key": "all", "label": "전체"}, {"key": "abnormal", "label": "이상", "where": {"status": ["이상"]}, "count": true}, {"key": "watch", "label": "주의", "where": {"status": ["주의"]}, "count": true}, {"key": "test", "label": "시험(제외)", "where": {"status": ["제외"]}, "count": true}, {"key": "normal", "label": "정상", "where": {"status": ["정상"]}}],
 "rules": [
  {"col": "status", "value": "이상", "text": "이상: 기준선보다 2.5%p 넘게 낮은 양산 로트"},
  {"col": "status", "value": "주의", "text": "주의: 기준선보다 1.5~2.5%p 낮은 양산 로트"},
  {"col": "status", "value": "정상", "text": "정상: 기준선 대비 편차가 1.5%p 이내인 양산 로트"},
  {"col": "status", "value": "제외", "text": "제외: 시험 생산 로트. 조건을 바꿔 돌린 로트라 비교와 기준선에서 뺀다"},
  {"text": "기준선 = 측정일 직전 28일 같은 공정 양산 로트의 수율 평균(시험 로트 제외)"},
  {"text": "장비 쏠림 = 이상·주의 로트가 특정 장비에 몰린 정도(장비별 순위 막대)"}
 ],
 "related": {"col": "equip", "title": "같은 장비의 최근 14일 로트", "days": 14, "item": "{lot_id}", "badge": "status", "note": "편차 {gap}%p"},
 "evidence": ["{lot_id} · {equip} ({proc} 공정, {vendor})", "수율 {yield}% / 기준선 {base}% (직전 4주 같은 공정 평균) → 편차 {gap}%p", "같은 장비({equip}) 최근 14일 로트 {_related}건 · 구분 {kind}"],
 "newRow": {"status": "정상", "kind": "양산", "measured": "{_today}T09:00:00"},
 "control": {"title": "일별 이상 로트 건수 관리도", "metric": "abnormal", "k": 1.5, "days": 14},
 "dist": {"title": "양산 로트 수율 분포(시험 제외)", "value": {"col": "yield"}, "unit": "%", "label": "수율", "groupBy": "proc", "where": {"!status": ["제외"]}},
 "matrix": {"title": "공정×판정 로트 건수", "rows": "proc", "cols": "status", "agg": "count"},
 "form": {"title": "조사 지정 입력", "intro": "이상 로트를 골라 조사 지정 또는 보류를 정하고 사유를 남기면 변경 이력에 쌓입니다.", "refLabel": "로트 ID", "refMsg": "존재하는 로트 ID 를 고르세요.", "openWhere": {"status": ["이상", "주의"]}, "who": "수율팀", "historyTitle": "최근 저장된 조사 판단", "emptyHistory": "저장된 조사 판단이 없습니다.", "itemHistoryTitle": "조사 판단 이력", "action": "조사 지정 입력",
  "fields": [
   {"key": "decision", "label": "판단", "type": "radio", "options": ["조사 지정", "보류"], "required": true, "msg": "조사 지정 또는 보류를 선택하세요."},
   {"key": "reason", "label": "사유 (필수)", "type": "textarea", "required": true, "msg": "사유를 입력하세요."}]},
 "notice": {"file": "yield-notice", "template": "[수율 이상 로트 조사 요청] {proc} 공정 담당자님\n- 로트: {lot_id} ({kind})\n- 장비: {equip} · {vendor}\n- 수율 {yield}% / 기준선 {base}% → 편차 {gap}%p\n- 측정: {measured:short} · 판정 {status}\n- 같은 장비의 최근 14일 로트와 함께 원인 후보로 올라와 있습니다."},
 "report": {"memoTitle": "수율 이상 로트 인수인계 메모"},
 "chat": {"on": true, "title": "수율 현황 질문", "suggestions": ["이상 로트가 몇 개야?", "주의 로트는 얼마나 돼?", "측정 로트는 몇 개야?"]}
}
