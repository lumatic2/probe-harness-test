{
 "name": "power",
 "import": {"maxKB": 500},
 "params": [
  {"key": "hi_pct", "label": "이상 상한(기준 대비)", "unit": "%", "type": "number", "default": 130, "min": 100, "max": 300, "step": 5, "affects": "기준보다 높은 칸의 이상 판정"},
  {"key": "lo_pct", "label": "이상 하한(기준 대비)", "unit": "%", "type": "number", "default": 60, "min": 0, "max": 100, "step": 5, "affects": "기준보다 낮은 칸의 이상 판정"},
  {"key": "skip_outage", "label": "정기 정전 구간 제외", "unit": "", "type": "bool", "default": true, "affects": "B동·C동 일요일 새벽 칸의 판정"}
 ],
 "judge": {"col": "status", "value": {"col": "ratio"}, "rules": [{"label": "정전 구간", "on": "$param:skip_outage", "where": {"status": ["정전 구간"]}}, {"label": "이상", "op": ">=", "at": "$param:hi_pct"}, {"label": "이상", "op": "<", "at": "$param:lo_pct"}], "else": "정상"},
 "whatIf": {"metrics": ["abnormal", "real", "outage"]},
 "app": {"name": "전력 사용량 이상", "title": "전력 사용량 이상 현황", "question": "현장 점검을 먼저 보낼 계량기는 어디인가", "asOf": "2026-10-28 09:00", "today": "2026-10-28",
  "limit": "가상 데이터(실제 건물·계량기와 무관) · 15분 간격이라 계량기 4개·5일(10-24~10-28 08:45)만 실음 · 기준 = 같은 요일·같은 시각의 과거 4주 평균 · 기준의 1.3배 이상이거나 0.6배 미만이면 이상 · 정기 정전(B동·C동 일요일 02:00~04:00)은 제외 · 연속 1~2칸짜리 이상은 계측 노이즈일 수 있어 오탐 가능성 높음으로 표시 · 이상이 곧 고장은 아님",
  "help": "시설팀 · 내선 4630 · 가상 번호", "user": {"name": "시설팀", "email": "facility@fab-ops.example", "initials": "시설"}, "icon": "cpu"},
 "entity": {"singular": "측정 구간", "plural": "측정 구간", "unit": "칸", "idLabel": "구간 ID", "searchHint": "구간 ID·계량기·동·이상 구간 검색", "ownerLabel": "동"},
 "cols": [
  {"key": "row_id", "label": "구간 ID", "type": "text", "width": 144},
  {"key": "ts", "label": "시각(15분)", "type": "date", "width": 120},
  {"key": "bldg", "label": "동", "type": "text", "filter": "select", "width": 72},
  {"key": "meter", "label": "계량기", "type": "text", "filter": "chip", "width": 96},
  {"key": "kwh", "label": "사용량(kWh)", "type": "number", "width": 96},
  {"key": "base", "label": "기준(kWh) 같은 요일·시각 4주 평균", "type": "number", "width": 140},
  {"key": "ratio", "label": "기준 대비(%)", "type": "number", "width": 96},
  {"key": "status", "label": "판정", "type": "enum", "badge": true, "filter": "select", "width": 96, "values": [{"v": "이상", "tone": "urgent"}, {"v": "정상", "tone": "muted", "done": true}, {"v": "정전 구간", "tone": "muted", "done": true}]},
  {"key": "run", "label": "이상 구간", "type": "text", "filter": "chip", "width": 88},
  {"key": "run_len", "label": "연속 칸 수", "type": "number", "width": 88},
  {"key": "fp", "label": "오탐 가능성", "type": "enum", "badge": true, "filter": "select", "width": 96, "values": [{"v": "낮음", "tone": "plain"}, {"v": "높음", "tone": "warn"}, {"v": "–", "tone": "muted"}]}
 ],
 "roles": {"id": "row_id", "title": "{meter} {_date}", "status": "status", "priority": null, "date": "ts", "owner": "bldg", "group": "bldg", "unit": "meter", "deadline": null},
 "group": {"col": "bldg", "label": "동", "suffix": "", "values": ["A동", "B동", "C동"]},
 "metrics": [
  {"key": "abnormal", "label": "이상 칸(15분)", "agg": "count", "where": {"status": ["이상"]}, "unit": "칸", "better": null},
  {"key": "real", "label": "오탐 가능성 낮은 이상 칸", "agg": "count", "where": {"status": ["이상"], "fp": ["낮음"]}, "unit": "칸", "better": null},
  {"key": "noise", "label": "오탐 가능성 높은 이상 칸", "agg": "count", "where": {"status": ["이상"], "fp": ["높음"]}, "unit": "칸", "better": null},
  {"key": "outage", "label": "정기 정전 구간(제외)", "agg": "count", "where": {"status": ["정전 구간"]}, "unit": "칸", "better": null},
  {"key": "kwh", "label": "사용량 합계", "agg": "sum", "col": "kwh", "unit": "kWh", "better": null}
 ],
 "cards": ["abnormal", "real", "noise", "outage", "kwh"],
 "progress": [],
 "due": "2026-10-30",
 "summary": ["abnormal", "real", "outage"], "summaryTargets": [],
 "trend": {"metric": "abnormal", "title": "일별 이상 칸 수", "allName": "전체"},
 "rank": {"col": "meter", "title": "계량기별 이상 칸 순위", "topN": 4, "where": {"status": ["이상"]}},
 "stack": {"title": "동별 판정 구성", "by": "bldg", "parts": "status"},
 "heat": {"title": "요일×시간대 이상 칸", "cols": "slot", "where": {"status": ["이상"]}},
 "funnel": {"title": "점검 대상 좁히기", "steps": [{"label": "측정 칸"}, {"label": "정기 정전 제외", "where": {"!status": ["정전 구간"]}}, {"label": "이상 칸", "where": {"status": ["이상"]}}, {"label": "오탐 가능성 낮음", "where": {"status": ["이상"], "fp": ["낮음"]}}]},
 "queue": {"title": "먼저 볼 이상 칸", "where": {"status": ["이상"], "fp": ["낮음"]}, "columns": ["row_id", "meter", "status", "ratio", "run"], "limit": 15, "topN": 5},
 "alerts": {"title": "오탐 가능성이 낮은 이상 구간", "where": {"status": ["이상"], "fp": ["낮음"]}, "badge": "status", "note": "{run} · 연속 {run_len}칸 · 기준 대비 {ratio}%", "limit": 5, "actionLabel": "이상 칸 보기"},
 "board": {"title": "판정 보드", "meta": "{meter} · 기준 대비 {ratio}%"},
 "timeline": {"title": "이상 구간 시각", "start": "ts", "end": "ts", "label": "{meter} {run}", "owner": "bldg", "where": {"status": ["이상"], "fp": ["낮음"]}},
 "activity": {"title": "최근 이상 칸", "who": "bldg", "what": "{meter} {run} 기준 대비 {ratio}%", "where": {"status": ["이상"]}},
 "layout": {"title": "계량기별 이상 칸", "unitCol": "meter", "cols": 4, "states": ["이상 없음", "이상 있음", "이상 다수"], "countWhere": {"status": ["이상"]}, "countLabel": "이상", "badAt": 5},
 "tabs": [{"key": "all", "label": "전체"}, {"key": "abnormal", "label": "이상", "where": {"status": ["이상"]}, "count": true}, {"key": "real", "label": "오탐 가능성 낮음", "where": {"status": ["이상"], "fp": ["낮음"]}, "count": true}, {"key": "noise", "label": "오탐 가능성 높음", "where": {"status": ["이상"], "fp": ["높음"]}, "count": true}, {"key": "outage", "label": "정기 정전", "where": {"status": ["정전 구간"]}, "count": true}],
 "rules": [
  {"col": "status", "value": "이상", "text": "이상: 사용량이 기준(같은 요일·같은 시각 과거 4주 평균)의 130% 이상이거나 60% 미만인 칸"},
  {"col": "status", "value": "정상", "text": "정상: 기준 대비 60~130% 안에 있는 칸"},
  {"col": "status", "value": "정전 구간", "text": "정전 구간: 정기 정전 시간대(B동·C동 일요일 02:00~04:00). 사용량이 0에 가까워도 이상으로 보지 않는다"},
  {"col": "fp", "value": "높음", "text": "오탐 가능성 높음: 연속 1~2칸(15~30분)만 튄 이상. 계측 노이즈일 수 있다"},
  {"col": "fp", "value": "낮음", "text": "오탐 가능성 낮음: 연속 3칸(45분) 이상 이어진 이상. 현장 확인 후보"},
  {"text": "기준 = 같은 요일·같은 시각의 과거 4주 값 평균. 휴일이나 행사로 부하가 달라진 날은 기준이 맞지 않을 수 있다"}
 ],
 "related": {"col": "meter", "title": "같은 계량기의 최근 5일 이상", "days": 5, "item": "{run}", "badge": "status", "note": "기준 대비 {ratio}%"},
 "evidence": ["{row_id} · {meter} ({bldg})", "사용량 {kwh}kWh / 기준 {base}kWh (같은 요일·시각 4주 평균) → 기준 대비 {ratio}%", "{run} 연속 {run_len}칸 · 오탐 가능성 {fp} · 같은 계량기 최근 5일 {_related}칸"],
 "newRow": {"status": "정상", "fp": "–", "ts": "{_today}T09:00:00"},
 "control": {"title": "시간별 이상 칸 수 관리도", "metric": "abnormal", "bucket": "hour", "k": 1.5, "days": 5},
 "dist": {"title": "기준 대비 사용량 분포(정전 구간 제외)", "value": {"col": "ratio"}, "unit": "%", "label": "기준 대비", "groupBy": "meter", "where": {"!status": ["정전 구간"]}},
 "matrix": {"title": "계량기×판정 측정 칸", "rows": "meter", "cols": "status", "agg": "count"},
 "form": {"title": "현장 점검 판단 입력", "intro": "이상 칸을 골라 현장 점검 또는 오탐 처리를 정하고 사유를 남기면 변경 이력에 쌓입니다.", "refLabel": "구간 ID", "refMsg": "존재하는 구간 ID 를 고르세요.", "openWhere": {"status": ["이상"], "fp": ["낮음"]}, "who": "시설팀", "historyTitle": "최근 저장된 점검 판단", "emptyHistory": "저장된 점검 판단이 없습니다.", "itemHistoryTitle": "점검 판단 이력", "action": "현장 점검 판단 입력",
  "fields": [
   {"key": "decision", "label": "판단", "type": "radio", "options": ["현장 점검", "오탐 처리"], "required": true, "msg": "현장 점검 또는 오탐 처리를 선택하세요."},
   {"key": "reason", "label": "사유 (필수)", "type": "textarea", "required": true, "msg": "사유를 입력하세요."}]},
 "notice": {"file": "power-notice", "template": "[전력 이상 현장 점검 요청] {bldg} 담당자님\n- 계량기: {meter} · 구간 {run}\n- 시각: {ts:short} · 사용량 {kwh}kWh (기준 {base}kWh, {ratio}%)\n- 연속 {run_len}칸 · 오탐 가능성 {fp}\n- 현장 점검 후보로 올라와 있습니다."},
 "report": {"memoTitle": "전력 이상 인수인계 메모"}
}
