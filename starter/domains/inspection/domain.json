  "limit": "가상 데이터(실제 설비와 무관) · 같은 장비에서 시간이 겹치는 뒤쪽 일정을 충돌로 표시 · 시작일이 최근 14일인 점검만 포함",
  "help": "설비 정비 당직 · 내선 4321 · 가상 번호", "user": {"name": "정비1팀", "email": "maint1@fab-ops.example", "initials": "정비"}, "icon": "wrench"},
 "entity": {"singular": "점검", "plural": "점검", "unit": "건", "idLabel": "점검 ID", "searchHint": "점검 ID·장비·라인·담당팀 검색", "ownerLabel": "담당팀"},
 "cols": [
  {"key": "insp_id", "label": "점검 ID", "type": "text", "width": 104},
  {"key": "equip", "label": "장비", "type": "text", "filter": "chip", "width": 96, "edit": true},
  {"key": "line", "label": "라인", "type": "text", "filter": "select", "width": 88},
  {"key": "kind", "label": "점검 항목", "type": "text", "filter": "select", "width": 136},
  {"key": "start", "label": "시작", "type": "date", "width": 120},
  {"key": "end", "label": "종료", "type": "date", "edit": true, "width": 120},
  {"key": "team", "label": "담당팀", "type": "person", "filter": "select", "edit": true, "width": 96, "options": ["정비1팀", "정비2팀", "정비3팀", "정비4팀"]},
  {"key": "status", "label": "상태", "type": "enum", "badge": true, "filter": "select", "edit": true, "width": 88, "values": [{"v": "예정", "tone": "plain"}, {"v": "진행", "tone": "warn"}, {"v": "완료", "tone": "muted", "done": true}, {"v": "충돌", "tone": "urgent"}]},
  {"key": "due", "label": "기한", "type": "date", "edit": true, "width": 104}
 ],
 "roles": {"id": "insp_id", "title": "{equip} {kind}", "status": "status", "priority": null, "date": "start", "owner": "team", "group": "line", "unit": "equip", "deadline": "due"},
 "group": {"col": "line", "label": "라인", "suffix": "", "values": ["A라인", "B라인", "C라인", "D라인", "E라인", "F라인"]},
 "metrics": [
  {"key": "doneRate", "label": "점검 완료율", "agg": "rate", "where": {"status": ["완료"]}, "unit": "%", "decimals": 1, "better": "up", "target": 80},
  {"key": "count", "label": "점검 건수", "agg": "count", "unit": "건", "better": null},
  {"key": "conflict", "label": "충돌", "agg": "count", "where": {"status": ["충돌"]}, "unit": "건", "better": "down", "target": 5},
  {"key": "overdue", "label": "기한 초과", "agg": "count", "where": {"$overdue": true}, "unit": "건", "better": "down"},
  {"key": "running", "label": "진행 중", "agg": "count", "where": {"status": ["진행"]}, "unit": "건", "better": null}
 ],
 "cards": ["doneRate", "count", "conflict", "overdue", "running"],
 "progress": ["doneRate", "conflict"],
 "due": "2026-10-31",
 "summary": ["conflict", "overdue", "running"], "summaryTargets": ["doneRate"],
 "trend": {"metric": "count", "title": "일별 점검 건수", "allName": "전체"},
 "rank": {"col": "team", "title": "담당팀별 미완료 점검", "topN": 5, "where": {"!status": ["완료"]}},
 "stack": {"title": "라인별 상태 구성", "by": "line", "parts": "status"},
 "heat": {"title": "요일×시간대 점검 시작", "cols": "slot"},
 "funnel": {"title": "점검 단계", "steps": [{"label": "점검 예정"}, {"label": "착수", "where": {"!status": ["예정"]}}, {"label": "완료", "where": {"status": ["완료"]}}]},
 "queue": {"title": "먼저 볼 점검", "where": {"!status": ["완료"]}, "columns": ["insp_id", "equip", "status", "start", "_dday"], "limit": 15, "topN": 5},
 "alerts": {"title": "충돌한 점검 일정", "where": {"status": ["충돌"]}, "badge": "status", "note": "{team} · {_dday}", "limit": 5, "actionLabel": "충돌 점검 보기"},
 "board": {"title": "점검 상태 보드", "meta": "{line} · {team}"},
 "timeline": {"title": "점검 일정", "start": "start", "end": "end", "label": "{equip} {kind}", "owner": "team", "where": {"!status": ["완료"]}},
 "activity": {"title": "최근 점검 이력", "who": "team", "what": "{_id} {equip} {status}", "where": {"status": ["완료", "충돌"]}},
 "layout": {"title": "장비 점검 현황", "unitCol": "equip", "cols": 6, "states": ["이상 없음", "충돌 있음", "충돌 다수"], "countWhere": {"status": ["충돌"]}, "countLabel": "충돌", "badAt": 2},
 "tabs": [{"key": "all", "label": "전체"}, {"key": "conflict", "label": "충돌", "where": {"status": ["충돌"]}, "count": true}, {"key": "running", "label": "진행", "where": {"status": ["진행"]}, "count": true}, {"key": "overdue", "label": "기한 초과", "where": {"$overdue": true}, "count": true}, {"key": "done", "label": "완료", "where": {"status": ["완료"]}}],
 "rules": [
  {"col": "status", "value": "예정", "text": "예정: 시작 시각 전이거나 아직 착수하지 않은 점검"},
  {"col": "status", "value": "진행", "text": "진행: 착수했지만 종료 시각까지 끝나지 않은 점검"},
  {"col": "status", "value": "완료", "text": "완료: 점검을 마치고 결과를 입력한 점검"},
  {"col": "status", "value": "충돌", "text": "충돌: 같은 장비의 앞선 점검과 시간이 겹치는 점검"},
  {"text": "기한 초과 = 기한이 오늘보다 앞서 있고 완료 상태가 아닌 건"},
  {"text": "점검 완료율 = 완료 건수 / 기간 내 점검 건수"}
 ],
 "related": {"col": "equip", "title": "같은 장비의 최근 14일 점검", "days": 14, "item": "{kind}", "badge": "status", "note": "{team}"},
 "evidence": ["{insp_id} · {equip} {kind}", "같은 장비({equip}) 최근 14일 점검 {_related}건", "상태 {status} · 담당 {team} · {_dday}"],
 "newRow": {"status": "예정", "team": "정비1팀", "start": "{_today}T09:00:00", "end": "{_today}T12:00:00"},
 "control": {"title": "일별 점검 건수 관리도", "metric": "count", "k": 1.5, "days": 14},
 "dist": {"title": "점검 소요 시간 분포", "value": {"diff": ["start", "end"], "per": "h"}, "unit": "시간", "label": "점검 소요", "groupBy": "line", "where": {"!status": ["예정"]}},
 "matrix": {"title": "라인×담당팀 점검 건수", "rows": "line", "cols": "team", "agg": "count"},
 "schedule": {"title": "점검 일정 격자", "resource": "equip", "resourceLabel": "장비", "label": "{kind}", "start": "start", "end": "end", "slot": {"unit": "day", "from": "2026-10-26", "count": 7}, "scale": "auto", "snapMinutes": 60, "where": {"!status": ["완료"]},
  "rules": [{"by": "equip", "max": 1, "label": "같은 장비 시간 겹침"}, {"by": "line", "max": 3, "label": "같은 라인 동시 점검 3건 초과"}, {"by": "team", "max": 3, "label": "같은 팀 동시 작업 3건 초과"}],
  "unassignedTitle": "일정 미정 점검", "confirmLabel": "확정", "who": "정비1팀"},
 "form": {"title": "점검 결과 입력", "intro": "점검을 고르고 소요 시간과 판정, 사유를 남기면 변경 이력에 쌓입니다.", "refLabel": "점검 ID", "refMsg": "존재하는 점검 ID 를 고르세요.", "openWhere": {"!status": ["완료"]}, "who": "정비1팀", "historyTitle": "최근 저장된 점검 결과", "emptyHistory": "저장된 점검 결과가 없습니다.", "itemHistoryTitle": "점검 결과 이력", "action": "점검 결과 입력",
  "fields": [
   {"key": "minutes", "label": "점검 소요(분)", "type": "number", "min": 0, "required": true, "msg": "점검 소요(분)를 0 이상의 숫자로 입력하세요."},
   {"key": "decision", "label": "판정", "type": "radio", "options": ["완료 확인", "재점검"], "required": true, "msg": "완료 확인 또는 재점검을 선택하세요."},
   {"key": "reason", "label": "사유 (필수)", "type": "textarea", "required": true, "msg": "사유를 입력하세요."}]},
 "notice": {"file": "inspection-notice", "template": "[설비 점검 안내] {team} 담당자님\n- 점검: {insp_id} ({kind})\n- 장비: {equip} · {line}\n- 일정: {start:short} ~ {end:short}\n- 상태: {status} · 기한 {due} {_dday}\n\n일정에 맞춰 점검을 진행하고 결과를 입력해 주세요."},
 "report": {"memoTitle": "점검 일정 인수인계 메모"}
}
